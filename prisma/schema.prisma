// Schema Prisma de Fitt — la description de la base de donnees.
// Apres CHAQUE modification de ce fichier :
//   npx prisma migrate dev --name description-du-changement
// Doc : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMERATIONS
// Stockees en MAJUSCULES non traduites (CLAUDE.md §8). La traduction francaise
// se fait a l'affichage, dans src/components/ui/badge.tsx.
// =============================================================================

enum StatutAdherent {
  ACTIF
  EXPIRE
  SUSPENDU
  EN_ATTENTE_VALIDATION
  ARCHIVE
}

enum Sexe {
  HOMME
  FEMME
}

enum UniteDuree {
  JOUR
  SEMAINE
  MOIS
  ANNEE
}

enum StatutAbonnement {
  ACTIF
  EXPIRE
  ANNULE
}

enum MethodePaiement {
  ESPECES
  WAVE
  ORANGE_MONEY
}

// Comment le passage a ete saisi. Sert aux rapports, jamais a la logique.
enum SourcePointage {
  KIOSQUE // borne a l'entree, en libre service
  STAFF // saisi par la reception
  ADHERENT // depuis l'espace adherent, avec le code du jour affiche a l'accueil
}

// ENCAISSEMENT : de l'argent entre, montant positif.
// ANNULATION   : l'ecriture de contrepartie exigee par le §9, montant negatif.
enum TypePaiement {
  ENCAISSEMENT
  ANNULATION
}

enum StatutSessionCours {
  PLANIFIEE
  ANNULEE
  TERMINEE
}

enum StatutReservation {
  CONFIRMEE
  ANNULEE
}

// Le cycle de vie d'une commande de boutique, du panier de l'adherent a la
// remise en salle (paiement sur place, CLAUDE.md — decision du 21/08/2026).
enum StatutCommande {
  EN_ATTENTE // l'adherent vient de commander, rien de prepare cote staff
  PRETE // le staff a prepare la commande, en attente de retrait
  RECUPEREE // remise a l'adherent et payee
  ANNULEE
}

// =============================================================================
// Gym — une salle de sport cliente. C'est le "tenant".
// Regle n°1 du projet : toute autre table porte un gymId pointant vers celle-ci.
// =============================================================================
model Gym {
  id String @id @default(cuid())

  // Lien vers l'organisation Clerk. Cle de voute de getTenantContext().
  clerkOrgId String @unique

  nom       String
  telephone String?
  adresse   String?
  ville     String? @default("Saint-Louis")

  actif Boolean @default(true)

  // Date de la PREMIERE activation par le Super Admin. Distingue deux etats
  // qui se ressemblent en base (actif=false) mais pas du tout dans la
  // realite : une salle jamais activee (activeeLe null) vs une salle
  // suspendue apres avoir tourne normalement (activeeLe renseigne). Ecrit
  // une seule fois, jamais efface — une suspension n'annule pas l'historique.
  activeeLe DateTime?

  // --- Commercialisation : essai et abonnement a Fitt -----------------------
  //
  // A ne pas confondre avec Abonnement, qui est le contrat d'un ADHERENT
  // envers sa salle. Ces deux champs decrivent la relation de la SALLE envers
  // AFRICATECHNOLOGIE.
  //
  // Fin de la periode d'essai. null = aucune limite fixee : la salle garde
  // l'acces indefiniment. C'est volontairement le defaut (decision du
  // 22/08/2026, essai accorde a la main salle par salle), et c'est aussi ce
  // qui rend le champ retrocompatible — les salles anterieures a cette
  // migration ne changent pas de comportement.
  essaiJusquau DateTime?

  // Cliente payante. Prime sur essaiJusquau : marquer une salle abonnee lui
  // rend l'acces meme si son essai est expire, sans avoir a effacer la date
  // — l'historique de l'essai reste lisible.
  abonnee Boolean @default(false)

  // Compteur du numero d'adherent, PAR SALLE (CLAUDE.md §8).
  // On l'incremente dans une transaction a chaque creation. Il ne redescend
  // jamais : un numero libere n'est pas reattribue, meme apres archivage.
  dernierNumeroAdherent Int @default(0)

  // Code de seance du jour, affiche en grand sur la borne d'accueil.
  //
  // /!\ C'est LA preuve de presence physique de l'auto-pointage : sans lui,
  // un adherent pointerait depuis son lit et le registre de la salle ne
  // vaudrait plus rien. Quatre chiffres, regenere chaque jour, jamais
  // communique en dehors des murs.
  //
  // Ce n'est pas un secret cryptographique et il n'a pas a l'etre : il ne
  // donne acces a aucune donnee, il atteste seulement qu'on a vu l'ecran de
  // l'accueil. D'ou le stockage en clair, contrairement aux jetons (§9).
  codePointage   String?
  codePointageLe DateTime? // le jour ou ce code a ete tire

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  adherents     Adherent[]
  formules      Formule[]
  abonnements   Abonnement[]
  paiements     Paiement[]
  pointages     Pointage[]
  liens         LienInscription[]
  invitations   Invitation[]
  sessions      SessionAdherent[]
  coachs        Coach[]
  typesCours    TypeCours[]
  sessionsCours SessionCours[]
  reservations  Reservation[]
  produits       Produit[]
  commandes      Commande[]
  lignesCommande LigneCommande[]

  @@map("gyms")
}

// =============================================================================
// Adherent — un client de la salle.
//
// Un adherent appartient a UNE seule salle (CLAUDE.md §4). Pas de compte
// transversal, pas d'inscription publique : il est cree par le staff ou arrive
// par lien d'invitation, et reste alors EN_ATTENTE_VALIDATION.
//
// Creer un adherent n'est PAS l'inviter : la salle doit rester 100 %
// fonctionnelle sans qu'aucun adherent n'ait active son espace.
// =============================================================================
model Adherent {
  id String @id @default(cuid())

  // --- Le tenant. Presente sur toute table metier, sans exception (§3). ---
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  // Numero visible par le gerant, imprime sur la carte : "FITT-0042" (§8).
  // Sequence par salle, jamais reutilisee.
  numero String

  prenom String
  nom    String

  // Stocke normalise "+221771234567" (§8). L'affichage remet les espaces.
  telephone String
  email     String?

  dateNaissance DateTime?
  sexe          Sexe?
  adresse       String?

  // Chemin dans Supabase Storage. Les initiales sont le cas NORMAL :
  // une salle qui saisit 300 adherents au carnet ne mettra pas 300 photos.
  photoUrl String?

  // /!\ Donnee DENORMALISEE et assumee.
  // EXPIRE se deduit de la table Abonnement, mais on le stocke pour pouvoir
  // l'indexer : "montre-moi les expires" est la requete la plus frequente du
  // gerant, et une jointure a chaque affichage serait lente.
  // Toute ecriture sur Abonnement doit donc resynchroniser ce champ.
  statut StatutAdherent @default(ACTIF)

  // Notes libres du staff (blessure, preference d'horaire...).
  // Aucun conseil sante ou nutrition automatique ici (§9) : Fitt enregistre,
  // il ne conseille pas.
  notes String?

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  // D'ou vient cette fiche : saisie par le staff (null) ou nee d'un lien
  // d'inscription. Sert a mesurer ce que le lien rapporte, et a retrouver
  // les fiches a verifier quand un lien a ete diffuse trop largement.
  lienInscriptionId String?
  lienInscription   LienInscription? @relation(fields: [lienInscriptionId], references: [id], onDelete: SetNull)

  abonnements  Abonnement[]
  paiements    Paiement[]
  pointages    Pointage[]
  invitations  Invitation[]
  sessions     SessionAdherent[]
  reservations Reservation[]
  commandes    Commande[]

  // --- Contraintes et index (CLAUDE.md §10) ---

  // Deux adherents de salles DIFFERENTES peuvent avoir le meme numero de
  // telephone (un couple, un parent qui inscrit son enfant). Deux adherents
  // de la MEME salle, non : ce serait un doublon de saisie.
  @@unique([gymId, telephone])
  @@unique([gymId, numero])
  // Requete la plus frequente du back-office.
  @@index([gymId, statut])
  // Tri par defaut de la liste : les derniers inscrits en premier.
  @@index([gymId, creeLe])
  @@map("adherents")
}

// =============================================================================
// Formule — une offre commerciale de la salle : "Mensuel", "Premium Annuel"...
//
// Une formule EVOLUE : son prix change, sa duree aussi. C'est pour cela qu'un
// Abonnement n'y lit jamais son prix ni sa duree en direct — il en garde une
// copie figee (voir plus bas).
// =============================================================================
model Formule {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  nom         String // "Premium Annuel"
  description String? // "Acces total + cours collectifs"

  // Entier en FCFA. Jamais de decimales, jamais de flottant (§8).
  prix Int

  // "1 MOIS", "3 MOIS", "1 ANNEE", "10 JOUR"...
  // Une unite calendaire plutot qu'un nombre de jours : "1 mois" a partir du
  // 31 janvier doit tomber au 28 fevrier, pas au 2 mars.
  dureeValeur Int
  dureeUnite  UniteDuree

  // Une formule utilisee ne se supprime pas, elle s'archive (§9) : sinon
  // l'historique des abonnements devient illisible.
  actif Boolean @default(true)

  // Ordre d'affichage choisi par le gerant.
  ordre Int @default(0)

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  abonnements Abonnement[]

  @@unique([gymId, nom])
  @@index([gymId, actif])
  @@map("formules")
}

// =============================================================================
// Abonnement — le contrat souscrit par un adherent, a une date donnee.
//
// /!\ REGLE CRITIQUE (CLAUDE.md §9)
// nomFormule, prixPaye et finLe sont des PHOTOGRAPHIES prises a la
// souscription. Ils ne sont JAMAIS recalcules a partir de la formule.
// Un changement de tarif ou de duree ne doit pas reecrire retroactivement les
// contrats en cours — c'est la comptabilite de la salle qui en depend.
// =============================================================================
model Abonnement {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  adherentId String
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Restrict)

  // Lien conserve pour les statistiques ("combien d'Annuel vendus ?").
  // Jamais pour lire le prix ou la duree : ceux-la sont copies ci-dessous.
  formuleId String
  formule   Formule @relation(fields: [formuleId], references: [id], onDelete: Restrict)

  // --- Les trois valeurs figees ---
  nomFormule String // le nom au jour de la vente
  prixPaye   Int // le tarif au jour de la vente, en FCFA
  finLe      DateTime // calculee UNE fois, a la souscription

  debutLe DateTime

  statut StatutAbonnement @default(ACTIF)

  // Annulation : jamais de suppression, motif obligatoire (esprit du §9).
  annuleLe   DateTime?
  motifAnnul String?

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  paiements Paiement[]

  // Requete la plus frequente de l'application (§10) : "quels abonnements
  // expirent bientot dans cette salle ?"
  @@index([gymId, finLe])
  @@index([gymId, adherentId])
  @@index([gymId, statut])
  @@map("abonnements")
}

// =============================================================================
// Paiement — une ecriture du journal de caisse de la salle.
//
// /!\ REGLE CRITIQUE (CLAUDE.md §9)
// Ce journal est en AJOUT SEUL. Une ligne ecrite n'est jamais modifiee, jamais
// supprimee. Annuler un encaissement, c'est ecrire une SECONDE ligne de montant
// negatif qui pointe vers la premiere — l'ecriture de contrepartie du
// comptable.
//
// Consequence pratique : tout total est un simple SUM(montant). Les
// annulations s'y neutralisent d'elles-memes, il est donc impossible d'oublier
// d'exclure un paiement annule d'une agregation. C'est exactement la raison de
// ce choix.
// =============================================================================
model Paiement {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  adherentId String
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Restrict)

  // Facultatif : la salle encaisse aussi des frais d'inscription ou un
  // arriere, sans qu'un abonnement precis soit en jeu.
  abonnementId String?
  abonnement   Abonnement? @relation(fields: [abonnementId], references: [id], onDelete: Restrict)

  // Facultatif de la meme facon : encaissement d'une commande de boutique,
  // remise en main propre a l'adherent.
  commandeId String?
  commande   Commande? @relation(fields: [commandeId], references: [id], onDelete: Restrict)

  // Entier en FCFA (§8). NEGATIF sur une ligne d'ANNULATION, et seulement
  // sur celle-la.
  montant Int

  methode MethodePaiement
  type    TypePaiement    @default(ENCAISSEMENT)

  // Numero de transaction Wave / Orange Money, ou numero de recu papier.
  reference String?
  note      String?

  // --- L'ecriture de contrepartie ---
  // Renseignes uniquement sur une ligne d'ANNULATION.
  // @unique : un encaissement ne peut etre annule qu'une fois. C'est la base
  // qui l'interdit, pas seulement le code.
  annuleId     String?   @unique
  annule       Paiement? @relation("Contrepartie", fields: [annuleId], references: [id], onDelete: Restrict)
  contrepartie Paiement? @relation("Contrepartie")

  // Obligatoire sur une ANNULATION (§9). Verifie par Zod avant ecriture :
  // PostgreSQL ne sait pas exprimer "obligatoire si type = ANNULATION".
  motif String?

  // Date de l'encaissement reel, saisie par le staff : le gerant peut
  // enregistrer lundi matin l'argent recu samedi soir.
  encaisseLe DateTime @default(now())

  creeLe DateTime @default(now())
  // Pas de majLe : une ligne de ce journal ne se modifie pas.

  // "Combien a-t-on encaisse ce mois-ci ?" — requete du tableau de bord.
  @@index([gymId, encaisseLe])
  @@index([gymId, adherentId])
  @@index([gymId, abonnementId])
  @@index([gymId, commandeId])
  @@map("paiements")
}

// =============================================================================
// Pointage — le passage d'un adherent a l'entree de la salle.
//
// /!\ CONTRAINTE STRUCTURANTE (CLAUDE.md §9)
// "Bloquer le pointage en cas de coupure reseau" est un interdit absolu : la
// salle doit rester ouverte meme quand la connexion tombe. Le kiosque garde
// donc les passages dans une file locale et les rejoue au retour du reseau.
//
// D'ou cleLocale : la borne genere elle-meme l'identifiant du passage, avant
// tout appel au serveur. Rejouer deux fois la meme file ne cree pas de
// doublon, c'est la contrainte unique qui l'interdit — au niveau de la base,
// pas dans le code.
// =============================================================================
model Pointage {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  adherentId String
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Restrict)

  // Heure REELLE du passage, pas celle de l'enregistrement : un passage garde
  // en file locale a 18 h et synchronise a 21 h reste un passage de 18 h.
  horodatage DateTime @default(now())

  source SourcePointage @default(KIOSQUE)

  // Photographie du statut au moment du passage, dans le meme esprit que le
  // prix fige d'un abonnement (§9) : "combien d'entrees d'adherents expires
  // ce mois-ci ?" doit rester repondable dans un an.
  statutAdherent StatutAdherent

  // Identifiant d'idempotence genere par la borne (crypto.randomUUID).
  cleLocale String

  creeLe DateTime @default(now())

  // Rejouer la file locale est sans risque : la base refuse le doublon.
  @@unique([gymId, cleLocale])
  // Index critique du §10 : "les passages d'aujourd'hui dans cette salle".
  @@index([gymId, horodatage])
  // Anti-rebond : "cet adherent a-t-il deja pointe il y a deux minutes ?"
  @@index([gymId, adherentId, horodatage])
  @@map("pointages")
}

// =============================================================================
// LienInscription — le lien de pre-inscription genere par la salle.
//
// /!\ REGLE CRITIQUE (CLAUDE.md §4 et §9)
// Le jeton n'est JAMAIS stocke en clair : "une lecture de la base donnerait
// acces a tous les espaces". Seule son empreinte SHA-256 vit ici. Le jeton
// lui-meme n'existe qu'une fois, dans la reponse de creation — exactement
// comme une cle d'API. Personne, pas meme un administrateur de la base, ne
// peut le retrouver ensuite.
//
// Ce lien ne cree PAS un compte adherent (§4 : il n'existe pas de page
// "creer mon compte"). Il cree une fiche en EN_ATTENTE_VALIDATION, que le
// staff doit valider. Une salle dont personne n'utilise le lien reste
// parfaitement fonctionnelle.
// =============================================================================
model LienInscription {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  // SHA-256 (64 caracteres hexa) d'un jeton de 32 octets aleatoires.
  // Unique sur toute la base : c'est par lui qu'on retrouve la salle, sans
  // qu'aucun gymId ne circule dans l'URL (§9).
  jetonHache String @unique

  // Pour que le gerant s'y retrouve : "Affiche accueil", "Rentree septembre".
  libelle String

  expireLe  DateTime
  revoqueLe DateTime?

  // null = illimite (une affiche a l'accueil). Le defaut propose par
  // l'interface est 1, conformement au "usage unique" du §4 ; un lien
  // multi-usages est un choix explicite du gerant.
  usagesMax Int?
  usages    Int  @default(0)

  // userId Clerk du membre du staff qui a genere le lien.
  creeParUserId String?

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  adherents Adherent[]

  @@index([gymId, creeLe])
  @@map("liens_inscription")
}

// =============================================================================
// Invitation — le lien d'activation de l'espace adherent (CLAUDE.md §10).
//
// A ne pas confondre avec LienInscription :
//   LienInscription : anonyme, partageable, CREE une fiche a valider ;
//   Invitation      : nominative, rattachee a un adherent DEJA existant,
//                     et ouvre l'acces a son espace personnel.
//
// /!\ Memes regles que tout jeton du projet (§4, §9) : 32 octets aleatoires,
// stockes HACHES en SHA-256, usage unique, 7 jours, revocables.
//
// Lot 2 : l'envoi passera par WhatsApp. Aujourd'hui le staff copie le lien et
// le transmet lui-meme — le modele n'a pas a changer pour autant.
// =============================================================================
model Invitation {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  adherentId String
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  jetonHache String @unique

  expireLe  DateTime
  // Usage unique (§4) : une fois consomme, le lien ne vaut plus rien.
  utiliseLe DateTime?
  revoqueLe DateTime?

  creeParUserId String?
  creeLe        DateTime @default(now())

  @@index([gymId, adherentId])
  @@map("invitations")
}

// =============================================================================
// SessionAdherent — la session de l'espace adherent.
//
// /!\ Aucun compte Clerk n'est cree pour un adherent (§5, §9) : Clerk facture
// au MAU, et 6 000 adherents feraient exploser le cout. La session est donc
// maison — un jeton dans un cookie httpOnly, dont la base ne connait que
// l'empreinte.
//
// 90 jours (§5) : un adherent ne retiendra pas un mot de passe, et ne doit pas
// avoir a redemander un acces a chaque visite.
// =============================================================================
model SessionAdherent {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  adherentId String
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Cascade)

  // SHA-256 du jeton depose dans le cookie. Voler la base ne donne acces a
  // aucune session.
  jetonHache String @unique

  expireLe  DateTime
  revoqueLe DateTime?

  // Permet au staff de voir si l'espace est reellement utilise, et de fermer
  // les sessions dormantes.
  dernierAccesLe DateTime @default(now())
  creeLe         DateTime @default(now())

  @@index([gymId, adherentId])
  @@map("sessions_adherent")
}

// =============================================================================
// Coach — la personne qui anime un cours.
//
// Une simple fiche, sur le meme principe qu'Adherent : pas de compte Clerk, pas
// de connexion au back-office (Lot 4, decision du 20/08). Le staff cree et gere
// ses fiches coachs, comme il gere ses adherents.
// =============================================================================
model Coach {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  prenom String
  nom    String

  telephone  String?
  specialite String? // "Yoga, Cross-training"
  photoUrl   String? // Chemin dans Supabase Storage, comme Adherent.photoUrl.

  // Un coach ayant anime des seances passees ne se supprime pas, il s'archive
  // (meme logique que Formule.actif, §9) : sinon l'historique des seances
  // pointerait vers un coach introuvable.
  actif Boolean @default(true)

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  sessionsCours SessionCours[]

  @@index([gymId, actif])
  @@map("coachs")
}

// =============================================================================
// TypeCours — le catalogue des types de seances proposees par la salle
// ("Yoga", "Cross-training", "Zumba"...), sur le meme principe que Formule.
// =============================================================================
model TypeCours {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  nom         String
  description String?

  // Pour l'affichage calendrier (une pastille de couleur par type).
  couleur String? @default("#FF6B35")

  // Valeurs par defaut proposees a la creation d'une seance ; modifiables au
  // cas par cas sur la seance elle-meme (SessionCours.dureeMinutes/capacite).
  dureeMinutes   Int @default(60)
  capaciteDefaut Int @default(15)

  // Un type utilise par des seances passees ne se supprime pas, il s'archive
  // (§9, meme logique que Formule).
  actif Boolean @default(true)
  ordre Int     @default(0)

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  sessions SessionCours[]

  @@unique([gymId, nom])
  @@index([gymId, actif])
  @@map("types_cours")
}

// =============================================================================
// SessionCours — une seance planifiee a une date et une heure precises.
//
// Contrairement a Abonnement, on ne fige PAS de photographie du nom du type de
// cours ou du coach ici : la photographie du §9 existe pour proteger un
// engagement financier (le prix paye par l'adherent). Renommer un TypeCours ou
// un Coach n'a aucune consequence comptable, la seance peut donc pointer en
// direct vers eux.
//
// placesReservees est un compteur a verrou optimiste (meme pattern que
// LienInscription.usages, §6) : lu, verifie localement, puis incremente via un
// updateMany conditionne sur la valeur lue. Une simple transaction Prisma ne
// suffit pas a proteger un compteur sous acces concurrent (deux inscriptions
// simultanees sur la derniere place).
// =============================================================================
model SessionCours {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  typeCoursId String
  typeCours   TypeCours @relation(fields: [typeCoursId], references: [id], onDelete: Restrict)

  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Restrict)

  debutLe      DateTime
  dureeMinutes Int // copie depuis TypeCours.dureeMinutes a la creation, modifiable au cas par cas

  capacite        Int // copie depuis TypeCours.capaciteDefaut a la creation, modifiable au cas par cas
  placesReservees Int @default(0)

  statut StatutSessionCours @default(PLANIFIEE)

  annuleLe   DateTime?
  motifAnnul String?

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  reservations Reservation[]

  // Requete la plus frequente : "le planning du jour dans cette salle".
  @@index([gymId, debutLe])
  @@index([gymId, coachId])
  @@index([gymId, typeCoursId])
  @@map("sessions_cours")
}

// =============================================================================
// Reservation — un adherent inscrit sur une SessionCours.
//
// Lot 4, premiere marche (decision du 20/08) : c'est le staff qui inscrit
// l'adherent depuis le back-office, pas de reservation en libre-service depuis
// l'espace adherent pour l'instant.
// =============================================================================
model Reservation {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  sessionCoursId String
  sessionCours   SessionCours @relation(fields: [sessionCoursId], references: [id], onDelete: Restrict)

  adherentId String
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Restrict)

  statut StatutReservation @default(CONFIRMEE)

  annuleLe   DateTime?
  motifAnnul String?

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  // Empeche un double clic de creer deux inscriptions du meme adherent sur la
  // meme seance.
  @@unique([sessionCoursId, adherentId])
  @@index([gymId, adherentId])
  @@index([gymId, sessionCoursId])
  @@map("reservations")
}

// =============================================================================
// Produit — le catalogue de la boutique de la salle (compléments, textiles,
// accessoires...). Par salle, comme une Formule.
//
// Un produit deja vendu ne se supprime jamais, il s'archive (actif=false,
// meme principe que Formule, §9) : sinon l'historique des commandes devient
// illisible.
// =============================================================================
model Produit {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  nom         String
  description String?

  // Entier en FCFA (§8).
  prix Int

  // Chemin dans Supabase Storage. Meme logique que Adherent.photoUrl : un
  // produit sans photo est le cas normal au demarrage de la boutique.
  photoUrl String?

  // Disponibilite geree a la main par le staff (decision du 21/08/2026) :
  // pas de quantite en stock a maintenir, juste "en vente" ou "en rupture".
  actif Boolean @default(true)

  ordre Int @default(0)

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  lignesCommande LigneCommande[]

  @@index([gymId, actif])
  @@map("produits")
}

// =============================================================================
// Commande — une commande de boutique passee par un adherent depuis son
// espace. Paiement a la recuperation en salle (decision du 21/08/2026), pas
// de paiement en ligne : voir Paiement.commandeId, qui reutilise le journal
// de caisse existant plutot que d'en creer un second.
// =============================================================================
model Commande {
  id String @id @default(cuid())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  adherentId String
  adherent   Adherent @relation(fields: [adherentId], references: [id], onDelete: Restrict)

  statut StatutCommande @default(EN_ATTENTE)

  // Note libre du staff : "rupture sur le shaker, contacter l'adherent"...
  note String?

  // Annulation : jamais de suppression, motif conserve (esprit du §9).
  annuleeLe  DateTime?
  motifAnnul String?

  // Renseigne quand le staff remet la commande a l'adherent.
  recupereeLe DateTime?

  creeLe DateTime @default(now())
  majLe  DateTime @updatedAt

  lignes    LigneCommande[]
  paiements Paiement[]

  @@index([gymId, statut])
  @@index([gymId, adherentId])
  @@map("commandes")
}

// Le detail d'une commande : quel produit, quelle quantite, a quel prix.
//
// /!\ REGLE CRITIQUE (CLAUDE.md §9, meme principe que Abonnement.prixPaye)
// nomProduit et prixUnitaire sont des PHOTOGRAPHIES prises au moment de la
// commande. Un changement de prix du produit ne doit jamais reecrire
// retroactivement une commande deja passee.
model LigneCommande {
  id String @id @default(cuid())

  // Porte par toute table metier, sans exception (§3) — meme une table de
  // detail comme celle-ci, voir Reservation pour le meme choix.
  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Restrict)

  commandeId String
  commande   Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)

  produitId String
  produit   Produit  @relation(fields: [produitId], references: [id], onDelete: Restrict)

  nomProduit   String
  prixUnitaire Int
  quantite     Int

  @@index([gymId, commandeId])
  @@map("lignes_commande")
}
